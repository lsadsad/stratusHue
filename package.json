{
  "name": "stratushue",
  "version": "1.2.0",
  "description": "Your Figma Plugin",
  "main": "code.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js",
    "build:prod": "cross-env NODE_ENV=production node esbuild.config.js",
    "build:plugin-ready": "npm run build:prod && node scripts/build-plugin-ready.js",
    "build:plugin-ready:zip": "npm run build:prod && node scripts/build-plugin-ready.js --package",
    "pkg": "npm run build:plugin-ready:zip",
    "ship": "npm run build:plugin-ready:zip",
    "package": "node scripts/package-plugin.js",
    "package:desktop": "node scripts/package-plugin.js \"%USERPROFILE%\\Desktop\"",
    "package:custom": "node scripts/package-plugin.js",
    "dev": "node esbuild.config.js --watch",
    "clean": "node -e \"import fs from 'fs'; if(fs.existsSync('dist')) fs.rmSync('dist',{recursive:true,force:true}); console.log('🧹 Cleaned dist directory')\"",
    "clean:all": "node -e \"import fs from 'fs'; ['dist','plugin-ready'].forEach(d => { if(fs.existsSync(d)) { fs.rmSync(d,{recursive:true,force:true}); console.log('🧹 Cleaned '+d+' directory'); } })\"",
    "lint": "eslint --ext .ts,.tsx --ignore-pattern node_modules .",
    "lint:fix": "eslint --ext .ts,.tsx --ignore-pattern node_modules --fix .",
    "validate": "npm run lint && npm run build && echo Build validation completed successfully",
    "type-check": "tsc --noEmit && tsc -p tsconfig.ui.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:performance": "vitest --run src/test/performance.test.ts",
    "test:navigation": "tsx src/test/run-tests.ts",
    "test:navigation:unit": "vitest --run src/test/navigation.test.ts src/test/navigation-context.test.ts",
    "test:navigation:integration": "vitest --run src/test/navigation-integration.test.ts src/test/navigation-ui-integration.test.ts",
    "test:navigation:settings": "vitest --run src/test/navigation-settings.test.ts",
    "info": "node -e \"import fs from 'fs'; const files=['dist/code.js','dist/ui.js','dist/styles.css']; console.log('📊 Build Output:'); files.forEach(f => { if(fs.existsSync(f)) { const size=(fs.statSync(f).size/1024).toFixed(1); console.log('  '+f+': '+size+' KB'); } });\"",
    "sync:prototype": "node scripts/sync-prototype.js"
  },
  "author": "",
  "license": "",
  "devDependencies": {
    "@figma/eslint-plugin-figma-plugins": "*",
    "@figma/plugin-typings": "^1.75.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/ui": "^3.2.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.19.0",
    "eslint": "^8.57.0",
    "jsdom": "^27.0.0",
    "lucide-static": "^0.577.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:@figma/figma-plugins/recommended"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "project": "./tsconfig.json",
      "tsconfigRootDir": "."
    },
    "ignorePatterns": [
      "dist/**",
      "plugin-ready/**",
      "packages/**",
      "node_modules/**",
      "tools/**",
      "scripts/**",
      "**/*.test.ts",
      "**/*.spec.ts",
      "vitest.config.ts"
    ],
    "root": true,
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_",
          "caughtErrorsIgnorePattern": "^_"
        }
      ]
    }
  },
  "dependencies": {
    "lottie-web": "^5.13.0"
  }
}
