{
  "enabled": true,
  "name": "Documentation Sync",
  "description": "Update documentation when feature modules change",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/bookmarks.ts",
      "src/navigation.ts",
      "src/emoji-manager.ts",
      "src/lemon-squeezy.ts"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A feature module has been updated. Please:\n1. Review the changes in the saved file\n2. Update relevant documentation in the docs/ directory\n3. Ensure feature descriptions match current implementation\n4. Update any API documentation if interfaces changed\n5. Check if README.md needs updates\n\nFocus on keeping documentation accurate and up-to-date."
  }
}