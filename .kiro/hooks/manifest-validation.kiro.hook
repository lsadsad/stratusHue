{
  "enabled": true,
  "name": "Manifest Validation",
  "description": "Validate Figma plugin manifest changes",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "manifest.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Validate the Figma plugin manifest.json file:\n1. Check required fields (id, name, api, main, ui)\n2. Verify permissions are appropriate\n3. Validate version format\n4. Check for common issues\n5. Suggest improvements if needed\n\nProvide a summary of validation results."
  }
}