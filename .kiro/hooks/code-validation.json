{
  "name": "Code Quality Validation",
  "description": "Run linting, type checking, and validation on TypeScript files",
  "trigger": {
    "type": "file_save",
    "patterns": ["src/**/*.ts"]
  },
  "actions": [
    {
      "type": "shell_command",
      "command": "npm run lint",
      "description": "Run ESLint checks"
    },
    {
      "type": "shell_command",
      "command": "npm run type-check",
      "description": "TypeScript type validation"
    }
  ],
  "enabled": true,
  "runInBackground": true,
  "debounceMs": 1000
}