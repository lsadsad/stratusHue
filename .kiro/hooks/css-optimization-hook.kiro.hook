{
  "enabled": true,
  "name": "CSS Optimization",
  "description": "Auto-format and optimize CSS files on save",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.css"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review and optimize the saved CSS file for:\n1. Proper formatting and indentation\n2. Remove any unused selectors\n3. Optimize for performance\n4. Ensure consistent naming conventions\n\nMake minimal changes and preserve existing functionality."
  }
}