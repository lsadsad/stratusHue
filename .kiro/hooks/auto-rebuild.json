{
  "name": "Auto-rebuild Plugin",
  "description": "Automatically rebuild the Figma plugin when source files change",
  "trigger": {
    "type": "file_save",
    "patterns": ["src/**/*.ts", "src/**/*.css", "src/**/*.html"]
  },
  "actions": [
    {
      "type": "shell_command",
      "command": "npm run build",
      "description": "Rebuild plugin for development"
    }
  ],
  "enabled": true,
  "runInBackground": true
}