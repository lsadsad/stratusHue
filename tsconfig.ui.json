{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2019",
    "lib": ["es2019", "dom"],
    "module": "esnext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "src/ui.ts",
    "src/ui/shared/**/*.ts",
    "src/ui/navigate/**/*.ts",
    "src/ui/lint/**/*.ts",
    "src/ui/scaffold/**/*.ts",
    "src/ui/bridge/**/*.ts",
    "src/types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}